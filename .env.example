# Optional LLM API keys for AI Front-End (nl_to_dsl) and AI Agentic Debugger
# Note: Zero-dependency deterministic offline mode is always enabled by default.

# OpenAI API Key (optional)
# OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API Key (optional)
# GEMINI_API_KEY=your-gemini-key-here

# Default AI Provider (mock, openai, gemini, or rule_based)
AI_COMPILER_LLM_PROVIDER=mock
AI_COMPILER_LLM_MODEL=default
